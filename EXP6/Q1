class Animal {
    void eat() {
        System.out.println("Animal is eating...");
    }
}

interface Pet {
    void play();
}

interface Trainable {
    void train();
}

class Dog extends Animal implements Pet, Trainable {
    public void play() {
        System.out.println("Dog loves to play fetch!");
    }

    public void train() {
        System.out.println("Dog is being trained!");
    }
}

public class TestInheritance {
    public static void main(String[] args) {
        Dog d = new Dog();
        d.eat();
        d.play();
        d.train();
    }
}

interface Shape {
    void draw();
}

interface ColoredShape extends Shape {
    void color();
}

class Circle implements ColoredShape {
    public void draw() {
        System.out.println("Drawing a circle...");
    }

    public void color() {
        System.out.println("Coloring the circle red...");
    }
}

public class InterfaceExtendExample {
    public static void main(String[] args) {
        Circle c = new Circle();
        c.draw();
        c.color();
    }
}
